{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bhaviksardar/fences-gateway/spec/rules/schema.json",
  "title": "Fences policy",
  "description": "A policy as it appears in a bundle (spec/PROTOCOL-GATEWAY.md). Meaning: spec/rules/README.md. An engine also rejects duplicate rule ids, which JSON Schema can't express.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "default": {"enum": ["allow", "deny"], "default": "deny"},
    "quarantined": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "on", "effect"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "on": {"enum": ["mcp", "http", "k8s"]},
        "effect": {"enum": ["allow", "deny", "approve"]},
        "agents": {"type": "array", "items": {"type": "string"}},
        "where": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
        "when": {"$ref": "#/$defs/when"},
        "limit": {"$ref": "#/$defs/limit"},
        "reason": {"type": "string", "maxLength": 500},
        "on_unavailable": {"enum": ["allow", "deny"], "default": "deny"}
      }
    },
    "field": {"type": "string", "pattern": "^[^.]+(\\.[^.]+)*$"},
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "op", "value"],
      "properties": {"field": {"$ref": "#/$defs/field"}, "op": true, "value": true},
      "oneOf": [
        {"properties": {"op": {"enum": ["is", "is_not", "contains", "not_contains", "matches"]}, "value": {"type": "string"}}},
        {"properties": {"op": {"const": "in"}, "value": {"type": "array", "items": {"type": "string"}}}},
        {"properties": {"op": {"enum": ["gt", "gte", "lt", "lte", "eq"]}, "value": {"type": "number"}}}
      ]
    },
    "hhmm": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "when": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "days": {"type": "array", "items": {"enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]}, "uniqueItems": true},
        "from": {"$ref": "#/$defs/hhmm"},
        "to": {"$ref": "#/$defs/hhmm"},
        "tz": {"type": "string", "default": "UTC"}
      }
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_s", "max"],
      "properties": {
        "window_s": {"type": "integer", "minimum": 1},
        "max": {"type": "number", "minimum": 0},
        "sum": {"$ref": "#/$defs/field"},
        "per": {"type": "array", "items": {"$ref": "#/$defs/field"}}
      }
    }
  }
}
