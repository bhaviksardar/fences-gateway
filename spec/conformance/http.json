{
  "about": "HTTP API calls: method, path patterns, body fields, amount caps (RULES.md, subject http). The policy is the roadmap's refunds example: at most $500 per hour per agent, refunds over $100 need approval.",
  "policy": {
    "rules": [
      {"id": "reads", "on": "http", "effect": "allow", "where": [{"field": "method", "op": "in", "value": ["GET", "HEAD"]}, {"field": "path", "op": "matches", "value": "/orders/*"}]},
      {"id": "refunds", "on": "http", "effect": "allow", "where": [{"field": "method", "op": "is", "value": "POST"}, {"field": "path", "op": "is", "value": "/refunds"}],
       "limit": {"window_s": 3600, "max": 500, "sum": "body.amount"}, "reason": "At most $500 of refunds per hour"},
      {"id": "big-refunds", "on": "http", "effect": "approve", "where": [{"field": "method", "op": "is", "value": "POST"}, {"field": "path", "op": "is", "value": "/refunds"},
       {"field": "body.amount", "op": "gt", "value": 100}], "reason": "Refunds over $100 need approval"},
      {"id": "no-admin", "on": "http", "effect": "deny", "where": [{"field": "path", "op": "matches", "value": "/admin*"}]}
    ]
  },
  "cases": [
    {"name": "GET an order",
     "request": {"agent": "refund-bot", "on": "http", "at": 1793610000, "method": "GET", "path": "/orders/1182"},
     "expect": {"decision": "allow", "rule": "reads"}},
    {"name": "DELETE an order: no rule, default deny",
     "request": {"agent": "refund-bot", "on": "http", "at": 1793610000, "method": "DELETE", "path": "/orders/1182"},
     "expect": {"decision": "deny", "rule": null}},
    {"name": "admin paths are denied whatever the method",
     "request": {"agent": "refund-bot", "on": "http", "at": 1793610000, "method": "GET", "path": "/admin/users"},
     "expect": {"decision": "deny", "rule": "no-admin"}},
    {"name": "small refund under the hourly cap",
     "request": {"agent": "refund-bot", "on": "http", "at": 1793610000, "method": "POST", "path": "/refunds", "body": {"order_id": "1182", "amount": 40}},
     "history": [{"agent": "refund-bot", "on": "http", "at": 1793609000, "method": "POST", "path": "/refunds", "body": {"amount": 100}}],
     "expect": {"decision": "allow", "rule": "refunds"}},
    {"name": "refund over $100 needs approval",
     "request": {"agent": "refund-bot", "on": "http", "at": 1793610000, "method": "POST", "path": "/refunds", "body": {"order_id": "1182", "amount": 240}},
     "expect": {"decision": "require_approval", "rule": "big-refunds", "reason": "Refunds over $100 need approval"}},
    {"name": "refund over $100, approved",
     "request": {"agent": "refund-bot", "on": "http", "at": 1793610000, "method": "POST", "path": "/refunds", "body": {"order_id": "1182", "amount": 240}},
     "approved": true,
     "expect": {"decision": "allow", "rule": "big-refunds"}},
    {"name": "refund over $100 as a string still needs approval",
     "request": {"agent": "refund-bot", "on": "http", "at": 1793610000, "method": "POST", "path": "/refunds", "body": {"order_id": "1182", "amount": "240.00"}},
     "expect": {"decision": "require_approval", "rule": "big-refunds"}},
    {"name": "exactly reaching the hourly cap is allowed",
     "request": {"agent": "refund-bot", "on": "http", "at": 1793610000, "method": "POST", "path": "/refunds", "body": {"amount": 100}},
     "history": [
       {"agent": "refund-bot", "on": "http", "at": 1793607000, "method": "POST", "path": "/refunds", "body": {"amount": 100}},
       {"agent": "refund-bot", "on": "http", "at": 1793608000, "method": "POST", "path": "/refunds", "body": {"amount": 300}}],
     "expect": {"decision": "allow", "rule": "refunds"}},
    {"name": "going past the hourly cap is rate limited",
     "request": {"agent": "refund-bot", "on": "http", "at": 1793610000, "method": "POST", "path": "/refunds", "body": {"amount": 1}},
     "history": [
       {"agent": "refund-bot", "on": "http", "at": 1793607000, "method": "POST", "path": "/refunds", "body": {"amount": 200}},
       {"agent": "refund-bot", "on": "http", "at": 1793608000, "method": "POST", "path": "/refunds", "body": {"amount": 300}}],
     "expect": {"decision": "rate_limited", "rule": "refunds", "reason": "At most $500 of refunds per hour"}},
    {"name": "an approved big refund still counts toward the cap",
     "request": {"agent": "refund-bot", "on": "http", "at": 1793610000, "method": "POST", "path": "/refunds", "body": {"amount": 90}},
     "history": [{"agent": "refund-bot", "on": "http", "at": 1793608000, "method": "POST", "path": "/refunds", "body": {"amount": 450}}],
     "expect": {"decision": "rate_limited", "rule": "refunds"}},
    {"name": "a refund with no amount can't be checked against the cap: rate limited",
     "request": {"agent": "refund-bot", "on": "http", "at": 1793610000, "method": "POST", "path": "/refunds", "body": {"order_id": "1182"}},
     "expect": {"decision": "rate_limited", "rule": "refunds"}},
    {"name": "a refund with a non-numeric amount: rate limited",
     "request": {"agent": "refund-bot", "on": "http", "at": 1793610000, "method": "POST", "path": "/refunds", "body": {"amount": "lots"}},
     "expect": {"decision": "rate_limited", "rule": "refunds"}},
    {"name": "refunds older than an hour don't count",
     "request": {"agent": "refund-bot", "on": "http", "at": 1793610000, "method": "POST", "path": "/refunds", "body": {"amount": 50}},
     "history": [{"agent": "refund-bot", "on": "http", "at": 1793606000, "method": "POST", "path": "/refunds", "body": {"amount": 500}}],
     "expect": {"decision": "allow", "rule": "refunds"}},
    {"name": "a negative amount is over the limit: it would lower the total for the next request",
     "request": {"agent": "refund-bot", "on": "http", "at": 1793610000, "method": "POST", "path": "/refunds", "body": {"amount": -1000}},
     "expect": {"decision": "rate_limited", "rule": "refunds", "reason": "At most $500 of refunds per hour"}},
    {"name": "a negative amount as a string is over the limit too",
     "request": {"agent": "refund-bot", "on": "http", "at": 1793610000, "method": "POST", "path": "/refunds", "body": {"amount": "-5"}},
     "expect": {"decision": "rate_limited", "rule": "refunds", "reason": "At most $500 of refunds per hour"}}
  ]
}
