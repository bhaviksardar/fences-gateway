{
  "about": "Behavior every subject shares: default, quarantine, decision order, condition ops, time windows, policy validation (RULES.md).",
  "policy": {"rules": []},
  "cases": [
    {"name": "no rules, default absent: deny",
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "crm", "tool": "read"},
     "expect": {"decision": "deny", "rule": null}},
    {"name": "no matching rule, default allow: allow",
     "policy": {"default": "allow", "rules": [{"id": "r", "on": "mcp", "effect": "deny", "where": [{"field": "tool", "op": "is", "value": "drop"}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "crm", "tool": "read"},
     "expect": {"decision": "allow", "rule": null}},
    {"name": "quarantined agent is denied even with an allow rule and default allow",
     "policy": {"default": "allow", "quarantined": ["bot"], "rules": [{"id": "all", "on": "mcp", "effect": "allow"}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "crm", "tool": "read"},
     "expect": {"decision": "deny", "rule": null}},
    {"name": "quarantine is per agent",
     "policy": {"quarantined": ["other"], "rules": [{"id": "all", "on": "mcp", "effect": "allow"}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "crm", "tool": "read"},
     "expect": {"decision": "allow", "rule": "all"}},
    {"name": "a rule for another subject doesn't match",
     "policy": {"rules": [{"id": "all", "on": "http", "effect": "allow"}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "crm", "tool": "read"},
     "expect": {"decision": "deny", "rule": null}},
    {"name": "a rule for other agents doesn't match",
     "policy": {"rules": [{"id": "all", "on": "mcp", "effect": "allow", "agents": ["a", "b"]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "crm", "tool": "read"},
     "expect": {"decision": "deny", "rule": null}},
    {"name": "empty agents list means every agent",
     "policy": {"rules": [{"id": "all", "on": "mcp", "effect": "allow", "agents": []}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "crm", "tool": "read"},
     "expect": {"decision": "allow", "rule": "all"}},
    {"name": "deny beats allow",
     "policy": {"rules": [{"id": "a-allow", "on": "mcp", "effect": "allow"}, {"id": "z-deny", "on": "mcp", "effect": "deny", "reason": "no"}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "crm", "tool": "read"},
     "expect": {"decision": "deny", "rule": "z-deny", "reason": "no"}},
    {"name": "deny beats approve",
     "policy": {"rules": [{"id": "ask", "on": "mcp", "effect": "approve"}, {"id": "no", "on": "mcp", "effect": "deny"}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "crm", "tool": "read"},
     "approved": true,
     "expect": {"decision": "deny", "rule": "no"}},
    {"name": "approve beats allow",
     "policy": {"rules": [{"id": "a", "on": "mcp", "effect": "allow"}, {"id": "b", "on": "mcp", "effect": "approve", "reason": "ask first"}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "crm", "tool": "read"},
     "expect": {"decision": "require_approval", "rule": "b", "reason": "ask first"}},
    {"name": "approve with a granted approval: allow",
     "policy": {"rules": [{"id": "b", "on": "mcp", "effect": "approve"}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "crm", "tool": "read"},
     "approved": true,
     "expect": {"decision": "allow", "rule": "b"}},
    {"name": "several deny rules: the first id is reported",
     "policy": {"rules": [{"id": "zz", "on": "mcp", "effect": "deny"}, {"id": "aa", "on": "mcp", "effect": "deny"}, {"id": "mm", "on": "mcp", "effect": "deny"}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "crm", "tool": "read"},
     "expect": {"decision": "deny", "rule": "aa"}},
    {"name": "ids sort by character code: uppercase before lowercase",
     "policy": {"rules": [{"id": "b", "on": "mcp", "effect": "allow"}, {"id": "Z", "on": "mcp", "effect": "allow"}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "crm", "tool": "read"},
     "expect": {"decision": "allow", "rule": "Z"}},

    {"name": "op is: case-sensitive",
     "policy": {"default": "allow", "rules": [{"id": "r", "on": "mcp", "effect": "deny", "where": [{"field": "tool", "op": "is", "value": "Drop"}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "crm", "tool": "drop"},
     "expect": {"decision": "allow", "rule": null}},
    {"name": "op is_not holds for a missing field",
     "policy": {"rules": [{"id": "r", "on": "mcp", "effect": "allow", "where": [{"field": "args.mode", "op": "is_not", "value": "force"}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "crm", "tool": "push", "args": {}},
     "expect": {"decision": "allow", "rule": "r"}},
    {"name": "op contains",
     "policy": {"rules": [{"id": "r", "on": "mcp", "effect": "deny", "where": [{"field": "args.cmd", "op": "contains", "value": "rm -rf"}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "sh", "tool": "run", "args": {"cmd": "cd / && rm -rf tmp"}},
     "expect": {"decision": "deny", "rule": "r"}},
    {"name": "op not_contains holds for a missing field",
     "policy": {"rules": [{"id": "r", "on": "mcp", "effect": "allow", "where": [{"field": "args.cmd", "op": "not_contains", "value": "sudo"}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "sh", "tool": "run"},
     "expect": {"decision": "allow", "rule": "r"}},
    {"name": "op matches: * crosses slashes",
     "policy": {"rules": [{"id": "r", "on": "mcp", "effect": "allow", "where": [{"field": "args.path", "op": "matches", "value": "/workspace/*"}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "fs", "tool": "write", "args": {"path": "/workspace/src/a.py"}},
     "expect": {"decision": "allow", "rule": "r"}},
    {"name": "op matches: the whole string must match",
     "policy": {"rules": [{"id": "r", "on": "mcp", "effect": "allow", "where": [{"field": "args.path", "op": "matches", "value": "/workspace/*"}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "fs", "tool": "write", "args": {"path": "/etc/x/workspace/a"}},
     "expect": {"decision": "deny", "rule": null}},
    {"name": "op matches: ? is exactly one character",
     "policy": {"rules": [{"id": "r", "on": "mcp", "effect": "allow", "where": [{"field": "tool", "op": "matches", "value": "get_?"}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "crm", "tool": "get_ab"},
     "expect": {"decision": "deny", "rule": null}},
    {"name": "op matches: [ ] and . are literal, not patterns",
     "policy": {"rules": [{"id": "r", "on": "mcp", "effect": "allow", "where": [{"field": "tool", "op": "matches", "value": "a.[bc]"}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "crm", "tool": "axb"},
     "expect": {"decision": "deny", "rule": null}},
    {"name": "op matches: literal [ ] match themselves",
     "policy": {"rules": [{"id": "r", "on": "mcp", "effect": "allow", "where": [{"field": "tool", "op": "matches", "value": "a.[bc]"}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "crm", "tool": "a.[bc]"},
     "expect": {"decision": "allow", "rule": "r"}},
    {"name": "op matches: * matches an empty run and newlines",
     "policy": {"rules": [{"id": "r", "on": "mcp", "effect": "deny", "where": [{"field": "args.cmd", "op": "matches", "value": "*git push*"}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "sh", "tool": "run", "args": {"cmd": "ls\ngit push"}},
     "expect": {"decision": "deny", "rule": "r"}},
    {"name": "op in",
     "policy": {"rules": [{"id": "r", "on": "mcp", "effect": "allow", "where": [{"field": "tool", "op": "in", "value": ["read", "list"]}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "crm", "tool": "list"},
     "expect": {"decision": "allow", "rule": "r"}},
    {"name": "text ops never match a number",
     "policy": {"default": "allow", "rules": [{"id": "r", "on": "mcp", "effect": "deny", "where": [{"field": "args.id", "op": "is", "value": "7"}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "crm", "tool": "get", "args": {"id": 7}},
     "expect": {"decision": "allow", "rule": null}},
    {"name": "number op gt",
     "policy": {"default": "allow", "rules": [{"id": "r", "on": "mcp", "effect": "deny", "where": [{"field": "args.amount", "op": "gt", "value": 100}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "pay", "tool": "refund", "args": {"amount": 100.5}},
     "expect": {"decision": "deny", "rule": "r"}},
    {"name": "number op gt: equal doesn't hold",
     "policy": {"default": "allow", "rules": [{"id": "r", "on": "mcp", "effect": "deny", "where": [{"field": "args.amount", "op": "gt", "value": 100}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "pay", "tool": "refund", "args": {"amount": 100}},
     "expect": {"decision": "allow", "rule": null}},
    {"name": "number ops gte, lt, lte, eq",
     "policy": {"rules": [{"id": "r", "on": "mcp", "effect": "allow", "where": [
       {"field": "args.a", "op": "gte", "value": 5}, {"field": "args.b", "op": "lt", "value": 5},
       {"field": "args.c", "op": "lte", "value": 5}, {"field": "args.d", "op": "eq", "value": 5}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "x", "tool": "t", "args": {"a": 5, "b": 4.99, "c": 5, "d": 5.0}},
     "expect": {"decision": "allow", "rule": "r"}},
    {"name": "a decimal string counts as a number (can't dodge a deny by quoting)",
     "policy": {"default": "allow", "rules": [{"id": "r", "on": "mcp", "effect": "deny", "where": [{"field": "args.amount", "op": "gt", "value": 100}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "pay", "tool": "refund", "args": {"amount": "1000.00"}},
     "expect": {"decision": "deny", "rule": "r"}},
    {"name": "a negative decimal string counts as a number",
     "policy": {"rules": [{"id": "r", "on": "mcp", "effect": "allow", "where": [{"field": "args.n", "op": "lt", "value": 0}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "x", "tool": "t", "args": {"n": "-3"}},
     "expect": {"decision": "allow", "rule": "r"}},
    {"name": "exponent strings aren't numbers",
     "policy": {"default": "allow", "rules": [{"id": "r", "on": "mcp", "effect": "deny", "where": [{"field": "args.amount", "op": "gt", "value": 100}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "pay", "tool": "refund", "args": {"amount": "1e3"}},
     "expect": {"decision": "allow", "rule": null}},
    {"name": "booleans aren't numbers",
     "policy": {"rules": [{"id": "r", "on": "mcp", "effect": "allow", "where": [{"field": "args.n", "op": "eq", "value": 1}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "x", "tool": "t", "args": {"n": true}},
     "expect": {"decision": "deny", "rule": null}},
    {"name": "a path through a non-object is missing",
     "policy": {"rules": [{"id": "r", "on": "mcp", "effect": "allow", "where": [{"field": "args.order.id", "op": "is_not", "value": "1"}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "x", "tool": "t", "args": {"order": "1"}},
     "expect": {"decision": "allow", "rule": "r"}},
    {"name": "nested paths",
     "policy": {"rules": [{"id": "r", "on": "mcp", "effect": "allow", "where": [{"field": "args.order.id", "op": "is", "value": "1182"}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "x", "tool": "t", "args": {"order": {"id": "1182"}}},
     "expect": {"decision": "allow", "rule": "r"}},
    {"name": "all conditions must hold",
     "policy": {"rules": [{"id": "r", "on": "mcp", "effect": "allow", "where": [{"field": "server", "op": "is", "value": "crm"}, {"field": "tool", "op": "is", "value": "read"}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "billing", "tool": "read"},
     "expect": {"decision": "deny", "rule": null}},

    {"name": "time window: at from, inside",
     "policy": {"rules": [{"id": "hours", "on": "mcp", "effect": "allow", "when": {"days": ["mon", "tue", "wed", "thu", "fri"], "from": "09:00", "to": "17:00"}}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "x", "tool": "t"},
     "expect": {"decision": "allow", "rule": "hours"}},
    {"name": "time window: a minute before from, outside",
     "policy": {"rules": [{"id": "hours", "on": "mcp", "effect": "allow", "when": {"from": "09:00", "to": "17:00"}}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793609940, "server": "x", "tool": "t"},
     "expect": {"decision": "deny", "rule": null}},
    {"name": "time window: at to, outside",
     "policy": {"rules": [{"id": "hours", "on": "mcp", "effect": "allow", "when": {"from": "09:00", "to": "17:00"}}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793638800, "server": "x", "tool": "t"},
     "expect": {"decision": "deny", "rule": null}},
    {"name": "time window: wrong day (Sunday), outside",
     "policy": {"rules": [{"id": "hours", "on": "mcp", "effect": "allow", "when": {"days": ["mon", "tue", "wed", "thu", "fri"]}}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793534400, "server": "x", "tool": "t"},
     "expect": {"decision": "deny", "rule": null}},
    {"name": "time window in a time zone: 13:30 UTC is 08:30 in New York, outside",
     "policy": {"rules": [{"id": "hours", "on": "mcp", "effect": "allow", "when": {"from": "09:00", "to": "17:00", "tz": "America/New_York"}}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793626200, "server": "x", "tool": "t"},
     "expect": {"decision": "deny", "rule": null}},
    {"name": "overnight window: Tuesday 23:30, starting Tuesday, inside",
     "policy": {"rules": [{"id": "night", "on": "mcp", "effect": "deny", "when": {"days": ["tue"], "from": "22:00", "to": "06:00"}}], "default": "allow"},
     "request": {"agent": "bot", "on": "mcp", "at": 1793748600, "server": "x", "tool": "t"},
     "expect": {"decision": "deny", "rule": "night"}},
    {"name": "overnight window: Wednesday 02:00 belongs to Tuesday's night, inside",
     "policy": {"rules": [{"id": "night", "on": "mcp", "effect": "deny", "when": {"days": ["tue"], "from": "22:00", "to": "06:00"}}], "default": "allow"},
     "request": {"agent": "bot", "on": "mcp", "at": 1793757600, "server": "x", "tool": "t"},
     "expect": {"decision": "deny", "rule": "night"}},
    {"name": "overnight window: Saturday 02:00 belongs to Friday's night, outside",
     "policy": {"rules": [{"id": "night", "on": "mcp", "effect": "deny", "when": {"days": ["tue"], "from": "22:00", "to": "06:00"}}], "default": "allow"},
     "request": {"agent": "bot", "on": "mcp", "at": 1794016800, "server": "x", "tool": "t"},
     "expect": {"decision": "allow", "rule": null}},

    {"name": "invalid policy: unknown op",
     "policy": {"rules": [{"id": "r", "on": "mcp", "effect": "allow", "where": [{"field": "tool", "op": "regex", "value": ".*"}]}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "x", "tool": "t"},
     "expect": {"error": "invalid_policy"}},
    {"name": "invalid policy: unknown effect",
     "policy": {"rules": [{"id": "r", "on": "mcp", "effect": "log"}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "x", "tool": "t"},
     "expect": {"error": "invalid_policy"}},
    {"name": "invalid policy: unknown subject",
     "policy": {"rules": [{"id": "r", "on": "grpc", "effect": "allow"}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "x", "tool": "t"},
     "expect": {"error": "invalid_policy"}},
    {"name": "invalid policy: duplicate id",
     "policy": {"rules": [{"id": "r", "on": "mcp", "effect": "allow"}, {"id": "r", "on": "mcp", "effect": "deny"}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "x", "tool": "t"},
     "expect": {"error": "invalid_policy"}},
    {"name": "invalid policy: malformed id",
     "policy": {"rules": [{"id": "has space", "on": "mcp", "effect": "allow"}]},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "x", "tool": "t"},
     "expect": {"error": "invalid_policy"}},
    {"name": "invalid policy: bad default",
     "policy": {"default": "maybe", "rules": []},
     "request": {"agent": "bot", "on": "mcp", "at": 1793610000, "server": "x", "tool": "t"},
     "expect": {"error": "invalid_policy"}}
  ]
}
